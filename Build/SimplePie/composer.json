  "description": "Locked SimplePie runtime bundle for Feed Display Classic installations",
  "license": "GPL-2.0-or-later",
  "type": "project",
  "require": {
    "php": ">=8.2 <8.6",
    "simplepie/simplepie": "^1.9"
